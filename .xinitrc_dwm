#!/usr/bin/env sh

has_exe() {
    which "$1" >/dev/null 2>/dev/null
}

[ -r "$HOME/.xinitrc_local_env" ] && eval "$(cat "$HOME/.xinitrc_local_env")"

[ -x "$HOME/.local/dwm/helpers/bar" ] && "$HOME/.local/dwm/helpers/bar" &
[ -x "$HOME/.xinitrc_common" ] && "$HOME/.xinitrc_common"
has_exe picom && picom \
    --no-fading-openclose \
    --no-fading-destroyed-argb \
    --backend glx \
    -c -D 1 &
has_exe nitrogen && nitrogen --restore &

[ -x "$HOME/.xinitrc_local" ] && "$HOME/.xinitrc_local"
if [ -x "$HOME/.xinitrc_local_post" ]; then
    dwm
    "$HOME/.xinitrc_local_post"
else
    exec dwm
fi
