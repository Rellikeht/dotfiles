set editor-command=st -e vim "%s"
set dark-mode=true
set history-max-items=20000
#set smooth-scrolling=true

set accelerated-2d-canvas=true
set hardware-acceleration-policy=ondemand
set webgl=true
set input-autohide=true
set spell-checking=false
set status-bar=true
set webinspector=trueset
set dns-prefetching=false
set html5-database=true
set html5-local-storage=true
set strict-ssl=false

set user-scripts=true
set stylesheet=true
set site-specific-quirks=true
set font-size=13px

set print-backgrounds=true
set offline-cache=true

set default-zoom=120
set hint-timeout=0
set hint-keys="asdfjkl;"
set hint-match-element=false

nunmap <c-z>
iunmap <c-z>

nnoremap O :tabopen<Space>
nnoremap + zi
nnoremap - zo
nnoremap = zz

shortcut-add @br=https://search.brave.com/search?q=$0
shortcut-default @br
:shortcut-add @qw=https://qwant.com?q=$0
:shortcut-add @dg=https://duckduckgo.com/?q=$0
:shortcut-add @dl=https://duckduckgo.com/lite/?q=$0
:shortcut-add @dh=https://html.duckduckgo.com/html?q=$0

source ~/.config/vimb/local
